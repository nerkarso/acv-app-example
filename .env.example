# Vision escalation provider: claude | local | none
VISION_PROVIDER=none

# Required only when VISION_PROVIDER=claude
ANTHROPIC_API_KEY=

# Required only when VISION_PROVIDER=local (e.g. a Qwen-VL-compatible server)
LOCAL_VLM_ENDPOINT=http://localhost:8000

# Confidence thresholds (0.0 - 1.0)
CONFIDENCE_AUTO_ACCEPT=0.90
CONFIDENCE_ESCALATE_MIN=0.70

# PaddleOCR minimum confidence before a reading is considered for
# auto-accept at all
PADDLE_OCR_CONFIDENCE_THRESHOLD=0.85

# SQLite database path
DATABASE_PATH=data/local.db

# Directories
DATA_DIR=data
UPLOADS_DIR=data/uploads
PROCESSED_DIR=data/processed
CROPS_DIR=data/crops
EXPORTS_DIR=data/exports

# Logging
LOG_LEVEL=INFO
